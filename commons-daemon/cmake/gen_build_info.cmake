# Writes build_info.h: the commit this binary is built from, for GET /health.
#
# Run as a CMake script on EVERY build (see the commons_build_info target in CMakeLists.txt), not once at configure:
# the droplet deploys with `cmake --build` and NO reconfigure, so a value baked in at configure time would go stale on
# exactly the deploys where it matters.
#
#   cmake -DSRC=<commons-daemon source dir> -DOUT=<build_info.h> -P gen_build_info.cmake
#
# Where the revision comes from, first match wins:
#   1. the COMMONS_BUILD_REV environment variable (an explicit override, used by tests)
#   2. <SRC>/.deployed-rev, first word: written by deploy/sync-to-droplet.sh BEFORE the build. The droplet is not a
#      git clone, so this is the only source of truth there ("<sha>" or "<sha>+dirty" from a dirty tree)
#   3. `git rev-parse HEAD` of the checkout SRC lives in, plus "+dirty" if a tracked file differs from HEAD (dev, CI)
#   4. "unknown"
# Whatever is chosen must look like a git sha (7-40 lowercase hex, optionally +dirty); anything else is skipped, so the
# value is always safe to put in a C string and in the JSON of /health.
#
# The header is rewritten only when its content changes, so an unchanged revision recompiles nothing and a changed one
# recompiles only src/buildinfo.cpp (the one file that includes it).

if(NOT DEFINED SRC OR NOT DEFINED OUT)
    message(FATAL_ERROR "usage: cmake -DSRC=<source dir> -DOUT=<build_info.h> -P gen_build_info.cmake")
endif()

# _rev_valid(<token> <out-var>): the token if it is a sha (+dirty), else "".
function(_rev_valid tok out)
    set(${out} "" PARENT_SCOPE)
    set(base "${tok}")
    set(suffix "")
    if(base MATCHES "^(.*)\\+dirty$")
        set(base "${CMAKE_MATCH_1}")
        set(suffix "+dirty")
    endif()
    string(LENGTH "${base}" n)
    if(base MATCHES "^[0-9a-f]+$" AND n GREATER_EQUAL 7 AND n LESS_EQUAL 40)
        set(${out} "${base}${suffix}" PARENT_SCOPE)
    endif()
endfunction()

set(rev "")

# 1. explicit override
if(NOT "$ENV{COMMONS_BUILD_REV}" STREQUAL "")
    _rev_valid("$ENV{COMMONS_BUILD_REV}" rev)
endif()

# 2. the marker the deploy sync writes next to the source
if(rev STREQUAL "" AND EXISTS "${SRC}/.deployed-rev")
    file(STRINGS "${SRC}/.deployed-rev" _lines LIMIT_COUNT 1)
    string(REGEX REPLACE "[ \t\r].*$" "" _tok "${_lines}")
    _rev_valid("${_tok}" rev)
endif()

# 3. git, when the source lives in a checkout
if(rev STREQUAL "")
    execute_process(COMMAND git -C "${SRC}" rev-parse HEAD
        RESULT_VARIABLE _rc OUTPUT_VARIABLE _sha OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc STREQUAL "0")
        execute_process(COMMAND git -C "${SRC}" diff --quiet HEAD -- .
            RESULT_VARIABLE _drc OUTPUT_QUIET ERROR_QUIET)
        if(_drc STREQUAL "0")
            _rev_valid("${_sha}" rev)
        else()
            _rev_valid("${_sha}+dirty" rev)
        endif()
    endif()
endif()

# 4. give up honestly
if(rev STREQUAL "")
    set(rev "unknown")
endif()

get_filename_component(_outdir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_outdir}")
set(_tmp "${OUT}.tmp")
file(WRITE "${_tmp}"
"// generated by cmake/gen_build_info.cmake on every build; do not edit
#pragma once
#define COMMONS_BUILD_REV \"${rev}\"
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_tmp}" "${OUT}")
file(REMOVE "${_tmp}")
