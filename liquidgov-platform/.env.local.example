# Copy to .env.local (gitignored, never committed) and fill in real values.
# Sourced by .claude/launch.json before starting liquidgov_http.

# YouTube Data API v3 key (search.list). Restrict it by HTTP referrer to
# this site's origin in Google Cloud Console. Jukebox search degrades to a
# plain "paste a link" box when this is unset — it is not required to run
# the server.
YOUTUBE_API_KEY=
