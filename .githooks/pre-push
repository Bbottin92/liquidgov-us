#!/usr/bin/env sh
# LiquidGov pre-push: binds EVERY agent that pushes (Claude, Grok, Grok Bot, Brandon), not just one agent's harness.
# Refuses the push if the store/undo/docs/assets have drifted apart (lgp1_consistency.py) or the app wiring is off
# (one_app_check.py). Both read files only, take about a second, and need no server.
# Why (2026-11-07): changes kept landing without their dependents (undo lists, CI checks, rollback binaries), and
# Brandon asked that "when one thing changes, everything thats effected by that change is also changed accordingly".
# Enable once per clone (worktrees share it):  git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)" || exit 1
# Pick an interpreter that actually RUNS: on Windows, `python3` can be the Microsoft Store stub that only prints
# "Python was not found" (2026-11-07, Git Bash). Try each candidate; never trust `command -v` alone.
PY=""
for c in python3 python py /c/Python314/python.exe /c/Python313/python.exe; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" >/dev/null 2>&1; then
    PY="$c"; break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-push: no working Python 3.8+ found, so the consistency checks could not run; refusing (fix PATH)." >&2
  exit 1
fi
fail=0
# one_app_check.py is the one-app wiring. pwa_files_check.py keeps the old Mail/Social/Civic
# manifests. naming_check.py reads naming.toml. The retired pwa_check.py is not here (#6847b).
# make_go_check.py (2026-11-08) runs deploy/make-go.py in a temp copy: right pair for the change, dry mode.
# tidy_worktrees_check.py and next_port_check.py (2026-11-08) run their scripts in throwaway trees.
# ci_gate_check.py (2026-11-08): deploy/ci-gate.sh against a fake gh, and the gate call in every make-go script.
# sync_gate_check.py (2026-11-09): sync-to-droplet.sh runs that gate on every real sync (covers the older go scripts).
# ci_gate_interop_check.py (2026-11-12): the gate with a fake git.exe that drops calls (WSL interop): retried, never a silent skip.
# rollback_guard_check.py (2026-11-09): the no-rollback guard, its rules on real history, and the sync's DEPLOYED_COMMIT.
# narration_files_check.py (2026-11-09): a narration file for every Laws chapter (the route builds the name).
# preflight_retry_check.py (2026-11-10): generated go scripts retry the preflight once on a WSL accept4 drop.
# Only the checks the change could affect run (Brandon 2026-11-10): affected_checks.py holds the list of checks and the
# files each one reads, and picks from the staged files (pre-commit sets LG_CHECK_MODE=--staged) or the commits being
# pushed (git's stdin here). It runs every check when the hooks or itself change, or when it can't tell what changed.
checks="$(git_stdin="$(cat)"; printf '%s\n' "$git_stdin" | "$PY" "$ROOT/scripts/affected_checks.py" "$ROOT" "${LG_CHECK_MODE:---push}")" || {
  echo "pre-push: affected_checks.py failed, so the checks could not be chosen; refusing." >&2
  exit 1
}
[ -z "$checks" ] && echo "pre-push: no check is affected by this change"
for check in $checks; do
  out="$("$PY" "$ROOT/tests/repo/$check" "$ROOT" 2>&1)"; rc=$?
  echo "$out" | tail -1
  if [ $rc -ne 0 ]; then
    echo "$out" | grep "FAIL" | head -15 >&2
    fail=1
  fi
done
if [ $fail -ne 0 ]; then
  echo "pre-push: refusing. Fix every FAIL above (update everything the change affects), commit, then push." >&2
  exit 1
fi
exit 0
