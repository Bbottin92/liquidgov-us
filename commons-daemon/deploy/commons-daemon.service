# systemd unit for the commons game daemon -- the sibling process to
# `liquidgov` on the same droplet (sibling.md). Separate unit, separate
# process, separate failure domain: this must be able to crash, OOM, or
# restart without ever touching civic's own unit or LGP1 store.
#
# Install (manual, on the droplet, as root -- not run by any script here):
#   cp commons-daemon.service /etc/systemd/system/commons-daemon.service
#   systemctl daemon-reload
#   systemctl enable --now commons-daemon
#
# Not installed/enabled by this repo automatically. Staged for review
# only -- see Persistence/TheCommons/deploy-plan.md for the full sequence
# this fits into (build step, directory creation, verification) before
# any of these commands are actually run.

[Unit]
Description=The Commons game daemon (presence + catalog, sibling to liquidgov)
# Intentionally NOT `After=liquidgov.service` / `Requires=` -- sibling.md:
# "A game write must not take down Genesis," and the reverse holds too --
# civic's own unit must never wait on or be coupled to this one's state.
After=network.target

[Service]
Type=simple
User=liquidgov
Group=liquidgov
# Sibling path, not inside /opt/liquidgov (sibling.md: "not inside the
# LGP1 store"). This is the daemon's own build output, distinct from
# /opt/commons/ (the nginx static alias target -- client files only,
# never the daemon binary or its source).
WorkingDirectory=/opt/commons-daemon
ExecStart=/opt/commons-daemon/build/commons_daemon /var/lib/commons/commons.sqlite

# sibling.md: "Budget the daemon small (tens of MB, MemoryMax=). If it
# OOMs, systemd restarts it. Civic keeps serving /." 96 occupants across
# 12 region maps plus SQLite catalogs is genuinely small; 64M leaves
# headroom without letting a leak or a bad request threaten the other
# process sharing this 512MB box.
MemoryMax=64M
CPUQuota=50%

# consensus.md's entire "failover" story for this single-instance daemon:
# systemd restarts the process, RAM presence is allowed to die (the
# spec), clients re-join. Not a crash loop guard beyond the default
# backoff -- a real, persistent crash should surface as a failed unit,
# not restart forever silently.
Restart=on-failure
RestartSec=2

# Defense in depth alongside the daemon's own 127.0.0.1 bind
# (main.cpp -- reviewer-fail in every review doc this project has: never
# 0.0.0.0). Loopback-only at the OS level too, not just the socket.
PrivateNetwork=false
IPAddressAllow=127.0.0.0/8 ::1
IPAddressDeny=any

# Least privilege: no reason for this process to touch anything outside
# its own working dir and its SQLite data dir.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/commons

[Install]
WantedBy=multi-user.target
