# Build output — not source.
/liquidgov_http
liquidgov-platform/liquidgov_http
liquidgov-platform/liquidgov_platform_*_test
*.o
build/

# Stray backup snapshot pulled in during environment setup (root-owned,
# predates this session's edits). Not source, not meant to be tracked.
/liquidgov-platform.bak/

# Windows NTFS alternate-data-stream markers from an extracted zip.
*:Zone.Identifier

# Runtime data: accounts, sessions, blobs. Never commit real or scratch
# store state — same reasoning as the store's own 0600 mode.
*.lgp
*.lgp.tmp
liquidgov_accounts.lgp
liquidgov_blobs/

# Local secrets (API keys etc). Never commit — see .env.local.example for
# the expected shape.
.env.local
liquidgov-platform/.env.local
