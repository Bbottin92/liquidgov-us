#!/usr/bin/env sh
# LiquidGov pre-push: binds EVERY agent that pushes (Claude, Grok, Grok Bot, Brandon), not just one agent's harness.
# Refuses the push if the store/undo/docs/assets have drifted apart (lgp1_consistency.py) or the app wiring is off
# (one_app_check.py). Both read files only, take about a second, and need no server.
# Why (2026-11-07): changes kept landing without their dependents (undo lists, CI checks, rollback binaries), and
# Brandon asked that "when one thing changes, everything thats effected by that change is also changed accordingly".
# Enable once per clone (worktrees share it):  git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)" || exit 1
# Pick an interpreter that actually RUNS: on Windows, `python3` can be the Microsoft Store stub that only prints
# "Python was not found" (2026-11-07, Git Bash). Try each candidate; never trust `command -v` alone.
PY=""
for c in python3 python py /c/Python314/python.exe /c/Python313/python.exe; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c "import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)" >/dev/null 2>&1; then
    PY="$c"; break
  fi
done
if [ -z "$PY" ]; then
  echo "pre-push: no working Python 3.8+ found, so the consistency checks could not run; refusing (fix PATH)." >&2
  exit 1
fi
fail=0
# one_app_check.py is the one-app wiring. pwa_files_check.py keeps the old Mail/Social/Civic
# manifests. naming_check.py reads naming.toml. The retired pwa_check.py is not here (#6847b).
# make_go_check.py (2026-11-08) runs deploy/make-go.py in a temp copy: right pair for the change, dry mode.
# tidy_worktrees_check.py and next_port_check.py (2026-11-08) run their scripts in throwaway trees.
# ci_gate_check.py (2026-11-08): deploy/ci-gate.sh against a fake gh, and the gate call in every make-go script.
# sync_gate_check.py (2026-11-09): sync-to-droplet.sh runs that gate on every real sync (covers the older go scripts).
# ci_gate_interop_check.py (2026-11-12): the gate with a fake git.exe that drops calls (WSL interop): retried, never a silent skip.
# rollback_guard_check.py (2026-11-09): the no-rollback guard, its rules on real history, and the sync's DEPLOYED_COMMIT.
# narration_files_check.py (2026-11-09): a narration file for every Laws chapter (the route builds the name).
# preflight_retry_check.py (2026-11-10): generated go scripts retry the preflight once on a WSL accept4 drop.
# Only the checks the change could affect run (Brandon 2026-11-10): affected_checks.py holds the list of checks and the
# files each one reads, and picks from the staged files (pre-commit sets LG_CHECK_MODE=--staged) or the commits being
# pushed (git's stdin here). It runs every check when the hooks or itself change, or when it can't tell what changed.
git_stdin="$(cat)"  # read once here: the pass records below need the pushed commit too (q278)
checks="$(printf '%s\n' "$git_stdin" | "$PY" "$ROOT/scripts/affected_checks.py" "$ROOT" "${LG_CHECK_MODE:---push}")" || {
  echo "pre-push: affected_checks.py failed, so the checks could not be chosen; refusing." >&2
  exit 1
}
[ -z "$checks" ] && echo "pre-push: no check is affected by this change"
# Linux-only checks are not run on Windows (2026-11-14, Brandon: "fix the windows hook so i dont need no-verify"):
# prebuilt_check.py's plain `bash` is WSL's bash.exe from Windows Python and exits 127, which refused every deploy-pair
# commit and every push to master from the PC. The list is run_hook_checks.LINUX_ONLY (one list); on other systems this
# prints nothing. Said on a SKIPPED line, never counted as passed; GitHub's hook-checks run (Linux) runs them on every
# push and ship.py waits for it. If the list cannot be read nothing is skipped (hook_linux_only_skip_check.py).
linux_only="$("$PY" "$ROOT/scripts/affected_checks.py" "$ROOT" --linux-only 2>/dev/null | tr '\n' ' ')" || linux_only=""
# Pass records (q278, Brandon 2026-11-21 "yes, make it the first item"): a commit that touched scripts/affected_checks.py
# ran every check at commit and again at push on the very same files (twice that night on wip/183). The checks read the
# files ON DISK, so a pass is recorded only for an exact tree: at commit, the index's tree when the disk matches the
# index (nothing unstaged, nothing untracked); at push, a check is skipped only when ONE ref is pushed, its commit's tree
# has a record for that check, and the disk is exactly that commit. Skips say SKIPPED, never passed; GitHub's
# hook-checks run still runs everything. Records live in the git dir (lg-check-pass/<tree>-<check>), never committed.
# Worked out here, before GIT_* is dropped: at commit the index may be GIT_INDEX_FILE. tests/repo/hook_pass_record_check.py
MODE="${LG_CHECK_MODE:---push}"
PASS_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/lg-check-pass"
disk_clean() { git diff --quiet "$@" 2>/dev/null && [ -z "$(git ls-files --others --exclude-standard 2>/dev/null)" ]; }
tree=""
if [ "$MODE" = "--staged" ]; then
  if disk_clean; then tree="$(git write-tree 2>/dev/null)" || tree=""; fi
else
  set -- $(printf '%s\n' "$git_stdin" | sed '/^$/d')
  if [ $# -eq 4 ]; then
    t="$(git rev-parse --verify -q "$2^{tree}" 2>/dev/null)" || t=""
    if [ -n "$t" ] && [ "$t" = "$(git rev-parse 'HEAD^{tree}' 2>/dev/null)" ] && disk_clean HEAD; then tree="$t"; fi
  fi
fi
# Checks never get git's hook variables (2026-11-14). Git runs a hook with GIT_DIR, GIT_INDEX_FILE and friends set; a
# check that builds a throwaway repo (prebuilt_check.py: git init, commit "one"/"two") then acted on THIS repository:
# core.bare=true in the main checkout and junk commits on a linked worktree's branch (twice, 2026-11-12). The selector
# above still needs them (a `git commit -a` index is in GIT_INDEX_FILE), so they are dropped only here, after it.
# Every GIT_* goes, the same as scripts/run_hook_checks.py does for CI (hook_git_env_check.py).
for v in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
for check in $checks; do
  case " $linux_only " in *" $check "*)
    echo "SKIPPED (Linux-only): $check  (not passed; GitHub's hook-checks run runs it)"; continue;;
  esac
  if [ -n "$tree" ] && [ "$MODE" != "--staged" ] && [ -f "$PASS_DIR/$tree-$check" ]; then
    echo "SKIPPED (passed at commit on tree $(printf '%.7s' "$tree"), same files): $check"; continue
  fi
  start=$(date +%s)
  out="$("$PY" "$ROOT/tests/repo/$check" "$ROOT" 2>&1)"; rc=$?
  echo "$(echo "$out" | tail -1)  [$(( $(date +%s) - start ))s]"
  if [ $rc -ne 0 ]; then
    echo "$out" | grep "FAIL" | head -15 >&2
    fail=1
  elif [ -n "$tree" ] && [ "$MODE" = "--staged" ]; then
    mkdir -p "$PASS_DIR" 2>/dev/null && : > "$PASS_DIR/$tree-$check" 2>/dev/null  # err-ok: no record only means a rerun
  fi
done
if [ $fail -ne 0 ]; then
  echo "pre-push: refusing. Fix every FAIL above (update everything the change affects), commit, then push." >&2
  exit 1
fi
exit 0
